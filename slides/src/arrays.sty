\NewDocumentCommand{\ArrayListVertical}{ O{CSUcyan} m }{%
  \foreach \element in {#2} {
    \ArrayNodeVertical[#1]{\element}
  }
}

\NewDocumentCommand{\ArrayGroupVerticle}{ m m m }{%
  \draw [decorate, decoration = {brace,raise=5pt,amplitude=8pt}, very thick] ([xshift=-1cm]#2.south west) -- ([xshift=-1cm]#1.north west) node [pos=0.5,left=12pt] {#3};
}

\NewDocumentCommand{\ArrayGroupVerticleRight}{ m m m }{%
  \draw [decorate, decoration = {brace,raise=5pt,amplitude=8pt}, very thick] ([yshift=-1pt]#1.north east) -- ([yshift=1pt]#2.south east) node [pos=0.5,right=12pt,align={left}] {#3};
}

\newcommand{\ArrayElLabelVerticle}[2][val] {%
  \node[label of array el, anchor=west, name=label, align=center] at ([xshift=6mm] #1.east) {#2};
  \draw[link] (label) -- (#1);
}

\NewDocumentCommand{\ArraySwapVerticle}{ d<> O{} m m } {
  \draw[link, stealth-stealth] ([yshift=-1mm]#3.east) to[bend left=#2] node[right] {\IfNoValueTF{#1}{swap}{#1}} ([yshift=1mm]#4.east);
}

\NewDocumentCommand{\ArrayNodeStack}{ o O{[\thearrayIndex]} m }{%
  \IfNoValueTF{#1}{ % set fill only if the optional parameter is present
    \node[node of array, anchor=south, name=val] at ([yshift=-1pt] prev.north) {#3};
  }{
    \node[node of array, anchor=south, name=val, fill=#1] at ([yshift=-1pt] prev.north) {#3};
  }
  \node[array index, anchor=east, name=index] at ([xshift=-1pt] val.west) {#2};
  \node[block] (prev) [fit=(val)]{};
  % \node[block] (\detokenize{index#2}) [fit=(val)]{};
  \node[block] (el#3) [fit=(val)]{};
  \node[block] (#2) [fit=(index) (val)]{};
  \stepcounter{arrayIndex}
}

\NewDocumentCommand{\ArrayNodeStackSpan}{ O{$\vdots$}  }{
  \node[span of array, anchor=south, name=prev] at ([yshift=-1pt] prev.north) {#1};
  \node[block] (space) [fit=(prev)]{};
}