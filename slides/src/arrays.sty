\NewDocumentCommand{\ArrayList}{ O{CSUcyan} m }{%
  \foreach \element in {#2} {
    \ArrayNode[#1]{\element}
  }
}

\NewDocumentCommand{\ArrayGroup}{ d<> m m m }{%

  % Set the height of the text
  \tikzmath{
    \amp=\IfNoValueTF{#1}{8pt}{#1};
  }
  
  % If the height of the text is changed with #1, adjust the amplitude to match
  \dimendef\textAbove=0
  \pgfmathsetlength{\textAbove}{13mm+\amp-8pt}%\the\textAbove

  \draw [decorate, decoration = {brace,raise=2em + 4pt,amplitude=\IfNoValueTF{#1}{\amp}{#1}}, very thick] ([xshift=2pt] #2.west) -- ([xshift=-2pt] #3.east) node [pos=0.5,above=\textAbove, name=groupLabel] {#4};
}

\NewDocumentCommand{\ArrayElLabel}{ d<> d<> O{val} m }{%
  \node[label of array el, name=label] at ([xshift=\IfNoValueTF{#2}{0mm}{#2},yshift=\IfNoValueTF{#1}{-4mm}{#1}] #3.south) {#4};
  \draw[link] (label) -- (#3);
}

\NewDocumentCommand{\ArraySwap}{ d<> O{} m m } {
  \draw[link, stealth-stealth] ([xshift=-2mm] #3.south east) to[bend right=#2] node[below] {\IfNoValueTF{#1}{swap}{#1}} ([xshift=2mm] #4.south west);
}


\NewDocumentCommand{\ArrayNodeVertical}{ o m }{%

  % Extract the first element value
  \StrBefore{#2,}{,}[\FirstValue]

  \IfNoValueTF{#1}{ % set fill only if the optional parameter is present
    \node[node of array, anchor=north, name=val] at ([yshift=1pt] prev.south) {\FirstValue};
  }{
    \node[node of array, anchor=north, name=val, fill=#1] at ([yshift=1pt] prev.south) {\FirstValue};
  }
  \node[block] (lastElValue) [fit=(val)]{};%

  \foreach \element [count=\i] in {#2} {
    \ifnum\i=1 % First element
    \else
      \node[subcomponent of array el, right = of lastElValue, name=lastElValue] {\element};%
    \fi
  }

  \node[array index, anchor=east] (index\thearrayIndex) at ([xshift=-1pt] val.west) {\textcolor{white!75!CSUblue}{[}\thearrayIndex\textcolor{white!75!CSUblue}{]}};
  \node[block] (prev) [fit=(val)]{};
  \node[block] (\detokenize{el#2}) [fit=(val)]{};
  % \node[block] (el#2) [fit=(val)]{};
  \node[block] (elAt\thearrayIndex) [fit=(val)]{}; % label element by index
  \coordinate (valPtr) at (val);
  \stepcounter{arrayIndex}
}

