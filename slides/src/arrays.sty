\RequirePackage{tikz}
\usepackage{xparse}
\usepackage{xstring}
\usetikzlibrary{positioning,fit,decorations.pathreplacing}
\usetikzlibrary{math} %needed tikz library
%\usetikzlibrary{calc,shapes.multipart,chains,arrows,fit}
\tikzset{
  node of array/.style = {
     draw,
     fill=CSUcyan,
     minimum height=8mm,
     minimum width=10mm,
     node distance=0mm,
     text=black,
     very thick,
     align=center,
     %font=\ttfamily\bfseries\large
   },
  subcomponent of array el/.style = {
    node of array,
    node distance=2pt,
  },
  additional subcomponent of array el/.style = {
    subcomponent of array el,% Inherit properties from the base style
    node distance=1pt and 2pt, % Different values for vertical and horizontal distances
  },
  link/.style = {
     -stealth,
     shorten >=1pt,
     shorten <=1pt,
     very thick
     },
  block/.style = {
    rectangle, inner sep=0pt,
    align=center
  },
  array index/.style = {
    font=\ttfamily\bfseries
  },
  label of array el/.style = {
    font=\ttfamily,
    inner sep=0pt,
    anchor=north,
    align=center
  },
  span of array/.style = {
    node of array,
    minimum height=18mm,
  }, 
  horizontal span of array/.style = {
    node of array,
    minimum width=20mm,
  }
}

\newcounter{arrayIndex} % counter for array indexes

\NewDocumentCommand{\ArrayLabel}{ O{0} O{0} m }{%
  \setcounter{arrayIndex}{0}
  \node[, name=prev] at (#2, #1) {#3};
}

\NewDocumentCommand{\ArrayNode}{ d<> o m }{%
  \IfNoValueTF{#2}{ % set fill only if the optional parameter is present
    \node[node of array, anchor=west, name=val] at ([xshift=-1.4pt] prev.east) {#3};
  }{
    \node[node of array, anchor=west, name=val, fill=#2] at ([xshift=-1.4pt] prev.east) {#3};
  }
  \IfNoValueTF{#1}{
    \node[array index, anchor=south, name=index] at ([yshift=1pt] val.north) {\textcolor{white!75!CSUblue}{[}\thearrayIndex\textcolor{white!75!CSUblue}{]}};
  }{
    \node[array index, anchor=south, name=index] at ([yshift=1pt] val.north) {#1};
  }
  \node[block] (prev) [fit=(val)]{};
  \node[block] (\detokenize{el#3}) [fit=(val)]{};
  \node[block] ({el#3}) [fit=(val)]{};
  \stepcounter{arrayIndex}
}

% Used for \vdot without space above, used for vertical spans
\makeatletter
\DeclareRobustCommand%
  \spaceFreeVdots{\vbox{\baselineskip4\p@ \lineskiplimit\z@
    \hbox{.}\hbox{.}\hbox{.}}}
\makeatother

\NewDocumentCommand{\ArrayNodeSpan}{ O{$\cdots$} m }{
  \node[horizontal span of array, anchor=west, name=prev] at ([xshift=-1pt] prev.east) {#1};
  \node[array index, anchor=south] at ([yshift=1pt] prev.north) {$\cdots$};
  \node[block] (space) [fit=(prev)]{};
  \addtocounter{arrayIndex}{#2}
}

\NewDocumentCommand{\ArrayNodeVerticalSpan}{ O{\spaceFreeVdots} m }{
  \node[span of array, anchor=north, name=prev] at ([yshift=1.4pt] prev.south) {#1};
  \node[array index, anchor=east] at ([xshift=-1pt] prev.west) {\spaceFreeVdots};
  \node[block] (space) [fit=(prev)]{};
  \addtocounter{arrayIndex}{#2}
}


