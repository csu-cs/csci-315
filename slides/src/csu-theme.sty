\usefonttheme[onlymath]{serif}

%\usepackage{epsfig}
\RequirePackage[normalem]{ulem} % Used for better underline functionality
\RequirePackage{soul}

\RequirePackage{graphicx}
\graphicspath{{../imgs/}}

\RequirePackage{amssymb,amsmath}
\RequirePackage[]{hyperref}
%\urlstyle{same}
\RequirePackage{href-ul} % Underline links
\renewcommand{\ULdepth}{1.8pt} % Set how tight underlines are (\uline)

\hypersetup{
  pdfpagelayout=SinglePage,
  pdfstartview=FitH   % fit page width to window
}

\RequirePackage{listings}
\lstset{%
  language=C++,
  basicstyle=\ttfamily\color{white},
  breaklines=true,
  breakatwhitespace=true,
  breakindent=3em,
  tabsize=4,
  showspaces=false,
  showstringspaces=false,
  commentstyle=\color{codeComment}\fontfamily{lmtt}\itshape,%Latin Modern Typewritter
  upquote=true,
  literate={~}{{\textasciitilde}}1,
  keepspaces,
  keywordstyle=\color{codeKeyword}\bfseries,
  identifierstyle=\color{codeVariable},
  stringstyle=\color{codeString},
  morekeywords={nullptr},%
  backgroundcolor=\color{codeBackground},
  %
  % Set numbering style
  frame=single,
  numbers=left,
  numbersep=5pt,
  numberstyle=\tiny\color{CSUcyan},
  xleftmargin=10pt
}

% Custom background to lstinline
\usepackage{realboxes}
\usepackage{xpatch}
\makeatletter
\xpretocmd\lstinline@{\Colorbox{codeBackground}\bgroup\appto\lst@DeInit{\egroup}}{}{}
\xpretocmd\lst@InlineG{\Colorbox{codeBackground}\bgroup\appto\lst@DeInit{\egroup}}{}{}
\makeatother



