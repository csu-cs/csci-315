\institute{
  Department of Computer Science\\
  Charleston Southern University
}

\pgfdeclareimage[height=1cm]{university-logo}{../imgs/csu-logo-white_gold.pdf}
\logo{\pgfuseimage{university-logo}}

% Change \emph command to be italic instead of underline
\renewcommand{\emph}[1]{\textit{\textbf{#1}}}

% Add title slide at the beginning of each section.
\AtBeginSection[]{
  \begin{frame}
  \vfill
  \centering
  \begin{beamercolorbox}[sep=8pt,center,shadow=false,rounded=alse]{title}
    \usebeamerfont{title}\insertsectionhead\par%
  \end{beamercolorbox}
  \vfill
  \end{frame}
}

% Remove Navigation Symbols (Buttons) from the bottom of each slide
\beamertemplatenavigationsymbolsempty
