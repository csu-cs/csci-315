% General setup stuff used in all the lecture slides.
% by Sean T. Hayes
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{csu-theme}[2022/07/29]

\setbeamertemplate{date}{} % Don't display the date in Beamer

\RequirePackage[boxed,vlined,figure]{algorithm2e}
\RequirePackage{xcolor}
\RequirePackage{colortbl}

%### colors
\definecolor{CSUblue}{HTML}{002855} % CSU Blue (primary)
\definecolor{CSUgold}{HTML}{A89968} % CSU Gold (primary)
\definecolor{CSUcyan}{HTML}{5eb6cd}
\definecolor{CSUslate}{HTML}{383838}
\definecolor{DarkGreen}{HTML}{25413a} % For contrast with gold.
\definecolor{MyPurple}{HTML}{995FA3} % Alternative color for highlight.
\definecolor{MyGreen}{HTML}{61ff7e} % Alternative color for highlight.

% Code colors (adapted from VS Code)
\definecolor{codeKeyword}{HTML}{569CD6}
\definecolor{codeVariable}{HTML}{d7c091}
% \colorlet{codeVariable}{CSUgold!70}
\definecolor{codeString}{HTML}{CE9178}
% \definecolor{codeEntity}{HTML}{DCDCAA}
\definecolor{codeBackground}{HTML}{0a0c10}
% \definecolor{codeOpeartor}{HTML}{B5CEA8}
\definecolor{codeComment}{HTML}{72ab58}

% Keep track of if subsection was passed as an option
% Used later to enabled/disable showing subsections
\newif\if@myShowsubsect\@myShowsubsectfalse
\DeclareOption{subsections}{\@myShowsubsecttrue}
\ProcessOptions\relax

\mode<presentation>{
  %\usetheme{Madrid}

  % title page colors
  \setbeamercolor{title}      {fg=CSUblue, bg=white}
  \setbeamercolor{author}     {fg=white, bg=}
  \setbeamercolor{institute}  {fg=white, bg=}
  \setbeamercolor{date}       {fg=CSUcyan, bg=}
  \setbeamercolor{subtitle}   {fg=CSUblue,  bg=}

  % frame title, background and content colors
  \setbeamercolor{background canvas}  {     bg=CSUblue}
  \setbeamercolor{frametitle}         {fg=CSUblue, bg=white}
  \setbeamercolor{framesubtitle}      {fg=CSUgold!45} %bg does not work
  \setbeamercolor{block title}        {bg=CSUgold, fg=black}
  \setbeamercolor{block body}         {fg=CSUblue, bg=white}
  \setbeamercolor{local structure}    {fg=CSUgold, bg=black} %bullets and so on
  \setbeamercolor{alerted text}       {fg=CSUgold}

  % % footline colors
  % \setbeamercolor{foot40}{fg=black,bg=black!40}
  % \setbeamercolor{foot65}{fg=white,bg=black!65}
  % \setbeamercolor{foot75}{fg=white,bg=black!75}

  % \setbeamercolor{titlelike}{fg=CSUblue, bg=white}

  \setbeamercolor{normal text}        {fg=white, bg=CSUblue}
  \setbeamercolor{palette primary}    {fg=white, bg=CSUblue}
  \setbeamercolor{palette secondary}  {fg=white, bg=} % sub sections
  \setbeamercolor{palette tertiary}   {fg=black, bg=CSUgold}% sections at the top
  \setbeamercolor{palette quaternary} {fg=white, bg=black}
  % \setbeamercolor{structure}          {fg=white} % itemize, enumerate, etc


  \setbeamercolor{caption name}{fg=CSUgold!70}


  % Show the sections at the top of each frame (but not subsections)
  \if@myShowsubsect
    \useoutertheme[subsection=true]{miniframes} % Alternatively: miniframes, infolines, split
  \else
    \useoutertheme[subsection=false]{miniframes}
  \fi

  \useinnertheme{circles}  % circle item bullets and circle enumeration bullets

  \setbeamerfont{title}{size=\LARGE}
  \setbeamerfont{block title}{size=\normalsize}

  \setbeamertemplate{mini frames}[default] % default, box, tick
  \setbeamertemplate{section in head/foot shaded}[default][60]
  \setbeamercolor{section in head/foot}{fg=black}

  %% gets rid of footer
  % \setbeamertemplate{footline}{}

  % set the caption option of the template (no prefix)
  \setbeamertemplate{caption}{\raggedright\insertcaption\par}


  % % Move mini-frames from the headline to the footline
  % \makeatletter
  % % helper
  % \newcommand\letbeamertemplate[2]{%
  %   \csletcs{beamer@@tmpl@#1}{beamer@@tmpl@#2}%
  % }

  % % Currently template `headline` is `miniframes theme`.
  % % First, copy `headline` to `footline`.
  % \letbeamertemplate{footline}{headline}
  % % Then, reset `headline`
  % \setbeamertemplate{headline}[default]
  % \makeatother

  % \setbeamercolor{mini frame}{fg=black,bg=}
}

