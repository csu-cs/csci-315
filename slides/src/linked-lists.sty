% parameters: [destination] [pointer loc] [line options (bend)] {title}
\NewDocumentCommand{\TailPtr}{ d<> d<> O{ele} O{last} O{} m }{%
  \node[pointer, anchor=north] (tEl) at ([xshift=\IfNoValueTF{#2}{0mm}{#2}, yshift=\IfNoValueTF{#1}{-4mm}{#1}] #4.south) {};%
  \coordinate (tPtr) at (tEl);%
  \fill (tPtr) circle(2pt);%
  \ifthenelse{\equal{#3}{null}}{}{%
    \draw[link] (tPtr) to[#5] (#3);%
  }
  \node[label of pointer, left = of tEl, name=tail, left=1pt] {#6};%
}

\newcommand{\LinkedList}[2][]{%
  \LinkPtr{pHead}
  \foreach \anElement in {#2} {
     \LinkedNode{\anElement}
  }

  % Display tail
  \ifthenelse{\equal{#1}{}}{
    %omitted
  }{%
    \TailPtr{pTail}
  }%
}
